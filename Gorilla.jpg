<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>موقعي الشخصي</title>
    <style>
        /* تنسيق لجعل الصفحة سوداء أو رمادية غامقة لتناسب أجواء الصورة، والصورة في المنتصف تماماً */
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #121212;
        }
        
        /* تنسيق الصورة وجعلها متجاوبة */
        .center-image {
            max-width: 90%;
            max-height: 90vh;
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
        }
    </style>
</head>
<body>

    <!-- ضع اسم الصورة هنا تماماً كما سميتها في المستودع -->
    <img src="gorilla.jpg" alt="صورة الغوريلا" class="center-image">

</body>
</html>
 
